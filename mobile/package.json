{
  "name": "agrikountr-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "AgriKountr Android app (same screens as the desktop, works offline, syncs with the shop computer over Wi-Fi)",
  "scripts": {
    "prepare-web": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.cpSync('../web','www',{recursive:true})\"",
    "sync": "npm run prepare-web && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
