{
  "name": "agrikountr-desktop",
  "productName": "AgriKountr",
  "version": "1.0.0",
  "description": "AgriKountr shop computer app: billing, stock, GST and the server phones sync with over Wi-Fi",
  "main": "main.js",
  "author": "AgriKountr",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "server": "node server.js",
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "tesseract.js": "~5.1.1",
    "@tesseract.js-data/eng": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "in.agrikountr.desktop",
    "productName": "AgriKountr",
    "files": ["main.js", "server.js", "ewb.js", "cloud.js", "google-oauth*.json", "web/**", "build/icon.png", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "asarUnpack": ["node_modules/tesseract.js/**", "node_modules/tesseract.js-core/**", "node_modules/@tesseract.js-data/**"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "AgriKountr" }
  }
}
